msgid "Network Link"
msgstr "Collegamento di rete"

msgctxt "#30126"
msgid "JagLink / CatBox serial link emulation for networked games."
msgstr "Emulazione del collegamento seriale JagLink / CatBox per giochi in rete."

msgctxt "#30128"
msgid "Automatic (use netplay when available)"
msgstr "Automatico (usa il netplay quando disponibile)"

