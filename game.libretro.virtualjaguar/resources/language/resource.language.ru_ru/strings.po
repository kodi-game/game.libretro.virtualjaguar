msgstr "+16"

msgctxt "#30203"
msgid "Analog Controller Offset (Y)"
msgstr "Смещение аналогового контроллера (Y)"

msgctxt "#30204"
msgid "As Analog Controller Offset (X), for the Y axis."
msgstr "Как «Смещение аналогового контроллера (X)», для оси Y."

msgctxt "#30205"
msgid "Analog Controller Response Curve (X)"
msgstr "Кривая отклика аналогового контроллера (X)"

msgctxt "#30206"
msgid "Response exponent for the X axis, anchored at full deflection: an exponent above 1.00 gives finer control near centre while full deflection still reads full scale. Unlike the mouse/rotary curves this costs no top speed, so there is no paired sensitivity control."
msgstr "Показатель отклика для оси X, привязанный к полному отклонению: показатель выше 1,00 даёт более тонкое управление около центра, при этом полное отклонение по-прежнему читается как полная шкала. В отличие от кривых мыши/спиннера это не снижает максимальную скорость, поэтому нет парного регулятора чувствительности."

msgctxt "#30207"
msgid "Analog Controller Response Curve (Y)"
msgstr "Кривая отклика аналогового контроллера (Y)"

msgctxt "#30208"
msgid "As Analog Controller Response Curve (X), for the Y axis."
msgstr "Как «Кривая отклика аналогового контроллера (X)», для оси Y."

msgctxt "#30209"
msgid "Input Port 1"
msgstr "Порт ввода 1"

msgctxt "#30210"
