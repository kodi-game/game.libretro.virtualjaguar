msgstr "Изменить сопоставления ввода для порта 1."

msgctxt "#30211"
msgid "Port 1 > Controller Type"
msgstr "Порт 1 > тип контроллера"

msgctxt "#30213"
msgid "Auto (per-title default)"
msgstr "Авто (по умолчанию для игры)"

msgctxt "#30214"
