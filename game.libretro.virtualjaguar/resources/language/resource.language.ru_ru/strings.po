msgctxt "#30195"
msgid "Analog Controller Dead Zone (Y)"
msgstr "Мёртвая зона аналогового контроллера (Y)"

msgctxt "#30196"
msgid "As Analog Controller Dead Zone (X), for the Y axis (pitch, or accelerator/brake on the driving controller)."
msgstr "Как «Мёртвая зона аналогового контроллера (X)», для оси Y (тангаж или акселератор/тормоз на рулевом контроллере)."

msgctxt "#30197"
msgid "Analog Controller Offset (X)"
msgstr "Смещение аналогового контроллера (X)"

msgctxt "#30198"
msgid "Subtracts a constant (in ADC counts) from every X sample, in host orientation before any device convention. Cancels a stick that rests off-centre; a centred stick is moved by it, which is the point."
msgstr "Вычитает константу (в отсчётах АЦП) из каждого сэмпла X, в ориентации хоста до любого соглашения устройства. Отменяет стик, который в покое находится вне центра; центрированный стик при этом смещается, в чём и суть."

